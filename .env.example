# FlowPilot AI environment configuration (example only)
# Copy this file to .env if you want to enable the real OpenAI provider.
# Do not commit .env to source control.

# Required only for real OpenAI mode. Leave blank for local/mock operation.
OPENAI_API_KEY=

# Optional. Model used by the real OpenAI provider.
OPENAI_MODEL=gpt-4o-mini

# Local application defaults. DATABASE_PATH may be left blank.
LLM_PROVIDER=template
DATABASE_PATH=
API_HOST=127.0.0.1
API_PORT=8000
REVIEW_API_KEY=
