# FlowPilot AI environment configuration example; no real credentials.
# The application reads process environment variables and does not load .env.

# Required only for real OpenAI mode. Leave blank for local/mock operation.
OPENAI_API_KEY=

# Optional. Model used by the real OpenAI provider.
OPENAI_MODEL=

# Agent mode defaults to mock. Set LLM_MODE=live only for deliberate
# live API calls, and still pass --live for evaluation scripts.
LLM_MODE=mock
REFUND_WINDOW_DAYS=30
NON_REFUNDABLE_CATEGORIES=digital,final_sale
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=

# Required by the HTTP review endpoint; configure securely in the API process.
REVIEW_API_KEY=
